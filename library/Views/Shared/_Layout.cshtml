
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MeowLibrary</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Playfair+Display:wght@600;700;800&display=swap"
          rel="stylesheet">

    <!-- Website Styles -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/library.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- FALLING FLOWERS -->
    <div class="flower-container" aria-hidden="true">
        <span class="falling-flower flower-1">✿</span>
        <span class="falling-flower flower-2">✿</span>
        <span class="falling-flower flower-3">❀</span>
        <span class="falling-flower flower-4">✿</span>
        <span class="falling-flower flower-5">❀</span>
        <span class="falling-flower flower-6">✿</span>
        <span class="falling-flower flower-7">❀</span>
        <span class="falling-flower flower-8">✿</span>
        <span class="falling-flower flower-9">❀</span>
        <span class="falling-flower flower-10">✿</span>
        <span class="falling-flower flower-11">❀</span>
        <span class="falling-flower flower-12">✿</span>
    </div>

    <!-- NAVIGATION BAR -->
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-3 px-md-5">

                <!-- BRAND -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-flower">✿</span>
                    <span class="brand-highlight">MYLibrary</span>
                </a>

                <!-- MOBILE TOGGLE -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <span class="nav-icon">⌂</span> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Books"
                               asp-action="Index">
                                <span class="nav-icon">▤</span> Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Member"
                               asp-action="Index">
                                <span class="nav-icon">♧</span> Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Loans"
                               asp-action="Index">
                                <span class="nav-icon">↗</span> Loans
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Note"
                               asp-action="Index">
                                <span class="nav-icon">✎</span> Notes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container-fluid main-container px-3 px-md-5">

        <main role="main">
            @RenderBody()
        </main>

    </div>

    <!-- FOOTER -->
    <footer class="site-footer">

        <div class="container-fluid px-3 px-md-5">

            <div class="footer-content">

                <div>
                    <div class="footer-brand">
                        <span>✿</span> MYLibrary
                    </div>

                    <small>
                        A little place for stories, knowledge, and imagination.
                    </small>
                </div>

                <div class="footer-right">

                    <a asp-controller="Home"
                       asp-action="Privacy">
                        Privacy Policy
                    </a>

                    <small>
                        © 2026 MYLibrary. All Rights Reserved.
                    </small>

                </div>

            </div>

        </div>

    </footer>

    <!-- JAVASCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
