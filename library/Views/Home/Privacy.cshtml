@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>
<style>
    .privacy-page {
        font-family: Arial, sans-serif;
        color: #333333;
        padding: 30px 15px;
    }

    .privacy-header {
        background: #333333;
        color: white;
        padding: 35px;
        border-radius: 12px;
        border-bottom: 6px solid #e84393;
        margin-bottom: 25px;
    }

    .privacy-header h1 {
        color: #f8a5c2;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .privacy-card {
        background: #f5f5f5;
        border: 1px solid #dddddd;
        border-left: 5px solid #e84393;
        border-radius: 8px;
        padding: 22px;
        margin-bottom: 18px;
    }

    .privacy-card h3 {
        color: #c2185b;
        font-weight: bold;
        margin-bottom: 12px;
    }

    .privacy-card p,
    .privacy-card li {
        line-height: 1.8;
    }

    .privacy-footer {
        text-align: center;
        background: #333333;
        color: white;
        padding: 18px;
        border-radius: 8px;
        margin-top: 25px;
    }

    .privacy-footer span {
        color: #f8a5c2;
        font-weight: bold;
    }
</style>

<div class="privacy-page">

    <div class="privacy-header">
        <h1>Privacy Policy</h1>
        <p>
            Your privacy matters to us. Learn how our library
            website handles and protects your information.
        </p>
        <small>Last updated: October 20, 2026</small>
    </div>

    <div class="privacy-card">
        <h3> Introduction</h3>
        <p>
            Welcome to our Library Management System. This Privacy
            Policy explains how information may be collected, used,
            and protected when you use our website.
        </p>
    </div>

    <div class="privacy-card">
        <h3> Information We Collect</h3>
        <p>Depending on how you use the system, we may process:</p>
        <ul>
            <li>Member names and email addresses.</li>
            <li>Library membership information.</li>
            <li>Book reservation details and reservation status.</li>
            <li>Information you submit through library forms.</li>
        </ul>
    </div>

    <div class="privacy-card">
        <h3> How We Use Your Information</h3>
        <p>Information is used to:</p>
        <ul>
            <li>Manage library member records.</li>
            <li>Organize book reservations.</li>
            <li>Maintain accurate library records.</li>
            <li>Improve the functionality of the website.</li>
        </ul>
    </div>

    <div class="privacy-card">
        <h3> Information Protection</h3>
        <p>
            We aim to protect library information through appropriate
            security measures and restricted access. However, no
            website or electronic storage system can guarantee
            absolute security.
        </p>
    </div>

    <div class="privacy-card">
        <h3> Sharing of Information</h3>
        <p>
            Personal information should only be accessed by authorized
            individuals for legitimate library purposes, or disclosed
            when required or permitted by applicable law.
        </p>
    </div>

    <div class="privacy-card">
        <h3> Data Retention</h3>
        <p>
            Information should only be retained for as long as
            necessary for library operations and applicable legal
            requirements. Records should be securely disposed of
            when no longer needed.
        </p>
    </div>

    <div class="privacy-card">
        <h3> Your Privacy Rights</h3>
        <p>
            Subject to applicable law, you may have the right to
            request access to, correction of, or deletion of your
            personal information. You may contact the library
            administrator regarding privacy concerns.
        </p>
    </div>

    <div class="privacy-card">
        <h3> Changes to This Policy</h3>
        <p>
            This Privacy Policy may be updated when the library
            system or its information-handling practices change.
            Updates should be reflected on this page.
        </p>
    </div>

    <div class="privacy-card">
        <h3> Contact Us</h3>
        <p>
            If you have questions about this Privacy Policy,
            please contact the library administrator.
        </p>
        <p>
            <strong>Library Management System</strong><br />
            Email: library@example.com
        </p>
    </div>

    <div class="privacy-footer">
        <p>
            <span>Library Management System</span><br />
            Protecting your information and supporting your learning.
        </p>
    </div>

</div>
<p>Use this page to detail your site's privacy policy.</p>
