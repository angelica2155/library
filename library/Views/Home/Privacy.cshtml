@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    /* =========================================
           PRIVACY PAGE - PASTEL FLOWER THEME
        ========================================= */

    .privacy-page {
        font-family: 'Nunito', sans-serif;
        color: #52685b;
        padding: 40px 20px;
        max-width: 1100px;
        margin: auto;
    }

    /* HEADER */

    .privacy-header {
        background: linear-gradient(135deg, #e5f5e9, #e5f1ff);
        color: #52685b;
        padding: 40px;
        border-radius: 25px;
        border: 2px solid #c5e4d0;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(120, 170, 145, 0.08);
        text-align: center;
    }

        .privacy-header .privacy-icon {
            font-size: 45px;
            margin-bottom: 12px;
        }

        .privacy-header h1 {
            color: #426b50;
            font-family: 'Playfair Display', serif;
            font-weight: bold;
            font-size: 34px;
            margin-bottom: 15px;
        }

        .privacy-header p {
            color: #637b6c;
            line-height: 1.8;
        }

        .privacy-header small {
            color: #81968a;
        }

    /* PRIVACY CARDS */

    .privacy-card {
        background: #f2faf4;
        border: 2px solid #d5eadb;
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 22px;
        box-shadow: 0 4px 14px rgba(120, 170, 145, 0.07);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        /* Alternate baby blue cards */

        .privacy-card:nth-of-type(even) {
            background: #f1f7ff;
            border-color: #d5e5f5;
        }

        /* Soft hover effect */

        .privacy-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(120, 170, 145, 0.12);
        }

        /* CARD HEADINGS */

        .privacy-card h3 {
            color: #528b6a;
            font-family: 'Playfair Display', serif;
            font-weight: bold;
            font-size: 21px;
            margin-bottom: 14px;
        }

        .privacy-card:nth-of-type(even) h3 {
            color: #5986aa;
        }

        /* CARD TEXT */

        .privacy-card p,
        .privacy-card li {
            line-height: 1.9;
            color: #63776b;
            font-size: 15px;
        }

        .privacy-card ul {
            padding-left: 25px;
        }

        .privacy-card li {
            margin-bottom: 7px;
        }

    /* PRIVACY FOOTER */

    .privacy-footer {
        text-align: center;
        background: linear-gradient(135deg, #e5f5e9, #e5f1ff);
        color: #52705d;
        padding: 25px;
        border: 2px solid #c5e4d0;
        border-radius: 20px;
        margin-top: 30px;
        box-shadow: 0 4px 14px rgba(120, 170, 145, 0.07);
    }

        .privacy-footer span {
            color: #426b50;
            font-weight: bold;
        }

        .privacy-footer p {
            line-height: 1.8;
            margin-bottom: 0;
        }

    /* MOBILE RESPONSIVE */

    @@media (max-width: 600px) {

        .privacy-page {
            padding: 25px 15px;
        }

        .privacy-header {
            padding: 25px 18px;
        }

            .privacy-header h1 {
                font-size: 28px;
            }

        .privacy-card {
            padding: 20px;
        }

            .privacy-card h3 {
                font-size: 19px;
            }
    }

    /* REDUCED MOTION */

    @@media (prefers-reduced-motion: reduce) {
        .privacy-card {
            transition: none;
        }

            .privacy-card:hover {
                transform: none;
            }
    }
</style>

<div class="privacy-page">

    <!-- HEADER -->
    <div class="privacy-header">
        <div class="privacy-icon">🌿 📖</div>

        <h1>Privacy Policy</h1>

        <p>
            Your privacy matters to us. Learn how our library
            website handles and protects your information.
        </p>

        <small>Last updated: October 20, 2026</small>
    </div>

    <!-- INTRODUCTION -->
    <div class="privacy-card">
        <h3>🌷 Introduction</h3>
        <p>
            Welcome to our Library Management System. This Privacy
            Policy explains how information may be collected, used,
            and protected when you use our website.
        </p>
    </div>

    <!-- INFORMATION COLLECTED -->
    <div class="privacy-card">
        <h3>📚 Information We Collect</h3>
        <p>Depending on how you use the system, we may process:</p>
        <ul>
            <li>Member names and email addresses.</li>
            <li>Library membership information.</li>
            <li>Book reservation details and reservation status.</li>
            <li>Information you submit through library forms.</li>
        </ul>
    </div>

    <!-- INFORMATION USE -->
    <div class="privacy-card">
        <h3>📝 How We Use Your Information</h3>
        <p>Information is used to:</p>
        <ul>
            <li>Manage library member records.</li>
            <li>Organize book reservations.</li>
            <li>Maintain accurate library records.</li>
            <li>Improve the functionality of the website.</li>
        </ul>
    </div>

    <!-- INFORMATION PROTECTION -->
    <div class="privacy-card">
        <h3>🔒 Information Protection</h3>
        <p>
            We aim to protect library information through appropriate
            security measures and restricted access. However, no
            website or electronic storage system can guarantee
            absolute security.
        </p>
    </div>

    <!-- SHARING -->
    <div class="privacy-card">
        <h3>💌 Sharing of Information</h3>
        <p>
            Personal information should only be accessed by authorized
            individuals for legitimate library purposes, or disclosed
            when required or permitted by applicable law.
        </p>
    </div>

    <!-- DATA RETENTION -->
    <div class="privacy-card">
        <h3>🗂️ Data Retention</h3>
        <p>
            Information should only be retained for as long as
            necessary for library operations and applicable legal
            requirements. Records should be securely disposed of
            when no longer needed.
        </p>
    </div>

    <!-- PRIVACY RIGHTS -->
    <div class="privacy-card">
        <h3>🌱 Your Privacy Rights</h3>
        <p>
            Subject to applicable law, you may have the right to
            request access to, correction of, or deletion of your
            personal information. You may contact the library
            administrator regarding privacy concerns.
        </p>
    </div>

    <!-- POLICY CHANGES -->
    <div class="privacy-card">
        <h3>📌 Changes to This Policy</h3>
        <p>
            This Privacy Policy may be updated when the library
            system or its information-handling practices change.
            Updates should be reflected on this page.
        </p>
    </div>

    <!-- CONTACT -->
    <div class="privacy-card">
        <h3>📧 Contact Us</h3>
        <p>
            If you have questions about this Privacy Policy,
            please contact the library administrator.
        </p>

        <p>
            <strong>Library Management System</strong><br />
            Email: library@example.com
        </p>
    </div>

    <!-- FOOTER -->
    <div class="privacy-footer">
        <p>
            <span>🌿 Library Management System</span><br />
            Protecting your information and supporting your learning. 📖
        </p>
    </div>
</div>


